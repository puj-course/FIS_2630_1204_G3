<script>
    const campo = document.getElementById('detalle');
    const cuenta = document.getElementById('cuenta');

    function actualizar() { cuenta.textContent = campo.value.length; }
    campo.addEventListener('input', actualizar);
    actualizar();

    document.querySelectorAll('.og-chip').forEach(c => {
        c.addEventListener('click', () => {
            campo.value = c.dataset.valor;
            actualizar();
            campo.focus();
        });
    });
</script>

<script>
    /* Solo visual: el aviso "Selecciona tu ciudad" no debe salir cuando
       la página se recarga por cambiar el país, ni quedarse después de
       elegir una ciudad. No cambia lo que se envía ni la validación. */
    (function () {
        const selPais = document.getElementById('pais');
        const selCiudad = document.getElementById('ciudad');
        const error = document.getElementById('errorCiudad');
        const ok = document.getElementById('ciudadConfirmada');

        try {
            if (sessionStorage.getItem('og-cambio-pais')) {
                sessionStorage.removeItem('og-cambio-pais');
                if (error && !selCiudad.value) error.hidden = true;
            }
        } catch (e) {}

        selPais.addEventListener('change', () => {
            try { sessionStorage.setItem('og-cambio-pais', '1'); } catch (e) {}
        });

        selCiudad.addEventListener('change', () => {
            const hay = selCiudad.value !== '';
            if (error) error.hidden = hay;
            ok.hidden = !hay;
        });
    })();
</script>
