# Copiar este archivo como .env (NO subir el .env al repo).
# Cada variable sobreescribe la propiedad equivalente de application.properties.
# Si una linea se deja comentada, se usa el valor de application.properties.

# Puerto del equipo donde se publica la app (por defecto 8090)
# WISETRIP_PUERTO=8090

# Puerto del equipo donde se publica el proxy Nginx (por defecto 80)
# PROXY_PUERTO=80

# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<db>?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# TELEGRAM_BOT_TOKEN=
# GEOAPIFY_API_KEY=
